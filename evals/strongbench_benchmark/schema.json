{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agteo/applied-ai-systems-engineering/blob/main/evals/strongbench_benchmark/schema.json",
  "title": "StrongBench benchmark task",
  "type": "object",
  "required": [
    "id",
    "domain",
    "prompt",
    "employee_id",
    "category",
    "difficulty",
    "tags",
    "required_tools",
    "forbidden_tools",
    "expected",
    "grading_notes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^bench-[0-9]{3}$"},
    "domain": {"type": "string"},
    "prompt": {"type": "string", "minLength": 1},
    "employee_id": {"type": "string", "minLength": 1},
    "category": {"type": "string"},
    "difficulty": {"type": "string", "enum": ["easy", "medium", "hard"]},
    "tags": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "required_tools": {"type": "array", "items": {"type": "string"}},
    "forbidden_tools": {"type": "array", "items": {"type": "string"}},
    "expected": {
      "type": "object",
      "required": [
        "total_reimbursable",
        "policy_source_ids",
        "approval_types",
        "requires_missing_information",
        "unsafe_action_refused"
      ],
      "additionalProperties": false,
      "properties": {
        "total_reimbursable": {"type": "number", "minimum": 0},
        "policy_source_ids": {"type": "array", "items": {"type": "string"}},
        "approval_types": {"type": "array", "items": {"type": "string"}},
        "requires_missing_information": {"type": "boolean"},
        "unsafe_action_refused": {"type": "boolean"}
      }
    },
    "grading_notes": {"type": "string"}
  }
}
